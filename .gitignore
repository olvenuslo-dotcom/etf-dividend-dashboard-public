Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# 수급 원자료 캐시 — 다시 받으면 되는 것이라 올리지 않는다
data/flow_cache/
# KIS 하루 단위 종목 캐시 (구성종목·투자자별) — 다시 받으면 된다
data/kis_cache/

# API 키·로그인 정보 — 절대 올리지 않는다 (src/env_keys.py 가 읽는다)
.env
