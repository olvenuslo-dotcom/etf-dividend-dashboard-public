data/private/

# 화이트리스트 원본 이미지 (회사에서 받은 자료)
data/reference/*.jpg
data/reference/*.png

# 작업하며 찍어 둔 화면 캡처 — 이어받는 데 필요 없다
캡처*.png
# 참고용으로 루트에 던져 놓는 화면 사진 (요구사항 전달용, 저장소에 남길 것 아님)
/*.jpg
/*.jpeg
/*.png
photo_*.jpg

# ── 환경·캐시 ──────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# 로컬에서만 쓰는 권한 설정
.claude/settings.local.json

# 회사 보안장비 인증서를 합친 CA 번들 — PC마다 달라서 자동 생성한다 (src/corp_ca.py)
data/corp-ca-bundle.pem

