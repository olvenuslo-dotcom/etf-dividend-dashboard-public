# 이 파일을 복사해 `.env` 로 만들고 값을 채우세요. `.env` 는 커밋되지 않습니다.
#
#   copy .env.example .env
#
# KRX 로그인 — data.krx.co.kr 이 Data Marketplace 로 개편되며 필요해졌습니다.
# 없으면 국내 수급·시세 조회가 전부 빈 표로 옵니다.
KRX_ID=
KRX_PW=

# 한국은행 ECOS 인증키 — https://ecos.bok.or.kr/api/ 에서 무료 발급
# 수출·국고채 금리·예탁금 시계열에 씁니다.
ECOS_API_KEY=

# KRX Open API 인증키 — https://openapi.krx.co.kr/ 에서 신청 (무료, 2~3시간 승인)
KRX_OPENAPI_KEY=
